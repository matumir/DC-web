<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fuerza HTTPS con 301. La doble condición evita bucles de redirección cuando
  # el SSL lo termina un proxy/balanceador (ahí %{HTTPS} llega "off" pero
  # X-Forwarded-Proto vale https).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://www.distribuidoracastelli.com/$1 [R=301,L]

  # Canonicalización de dominio: redirige no-www -> www con 301 (permanente).
  # Consolida las señales de SEO bajo una sola URL: https://www.distribuidoracastelli.com
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.distribuidoracastelli.com/$1 [R=301,L]

  # SPA fallback: cualquier ruta que no sea un archivo/carpeta real
  # se sirve con index.html para que React Router la resuelva en el navegador.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Declara UTF-8 en la cabecera HTTP (Content-Type), no solo en el <meta> del HTML.
AddDefaultCharset UTF-8

# Compresión gzip para texto/JS/CSS/SVG/JSON/XML
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json application/xml text/xml image/svg+xml
</IfModule>

# Cache-Control:
# - JS/CSS: Vite les agrega hash al nombre, son inmutables -> cache largo (1 año).
# - Imágenes: nombres fijos (sin hash), pueden reemplazarse -> cache moderado (30 días).
# - HTML/sitemap/robots: el contenido puede cambiar (productos, pre-render) -> sin cache, siempre revalidar.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # ---- Cabeceras de seguridad ----

  # Impide que el navegador "adivine" el tipo de archivo. Sin esto, un archivo
  # subido como imagen pero con contenido HTML podria ejecutarse como pagina.
  Header always set X-Content-Type-Options "nosniff"

  # Nadie puede meter el sitio en un iframe: evita clickjacking, que es
  # superponer el sitio invisible sobre otro para robar clicks.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Al salir del sitio solo se informa el dominio, nunca la URL completa.
  # Importante porque hay rutas privadas como /panel y /favoritos.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # No usamos camara, microfono ni ubicacion: se niegan explicitamente para
  # que ningun script de terceros pueda pedirlos.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HSTS: obliga al navegador a usar HTTPS por un año, incluso si alguien
  # escribe http://. Se activa recien despues de confirmar que todo el sitio
  # carga bien por HTTPS, porque revertirlo lleva tiempo.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
